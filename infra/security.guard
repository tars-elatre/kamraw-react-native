let databases = Resources.*[ Type == 'AWS::RDS::DBInstance' ]
rule private_encrypted_database when %databases !empty {
  %databases.Properties.PubliclyAccessible == false
  %databases.Properties.StorageEncrypted == true
  %databases.Properties.ManageMasterUserPassword == true
  %databases.Properties.BackupRetentionPeriod >= 1
  %databases.Properties.DeletionProtection == true
}
let servers = Resources.*[ Type == 'AWS::EC2::Instance' ]
rule imdsv2 when %servers !empty {
  %servers.Properties.MetadataOptions.HttpTokens == 'required'
  %servers.Properties.BlockDeviceMappings.*.Ebs.Encrypted == true
}
let buckets = Resources.*[ Type == 'AWS::S3::Bucket' ]
rule private_buckets when %buckets !empty {
  %buckets.Properties.PublicAccessBlockConfiguration.BlockPublicAcls == true
  %buckets.Properties.PublicAccessBlockConfiguration.BlockPublicPolicy == true
}
