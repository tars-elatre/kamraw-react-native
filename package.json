{
  "name": "kamraw",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "npm run build -w @kamraw/domain && npm run build -w @kamraw/api && npm run build -w @kamraw/web",
    "typecheck": "npm run build -w @kamraw/domain && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test -w @kamraw/domain && npm run test -w @kamraw/api && npm run test -w @kamraw/mobile",
    "dev:api": "npm run dev -w @kamraw/api",
    "dev:web": "npm run dev -w @kamraw/web",
    "dev:mobile": "npm run start -w @kamraw/mobile"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "test-renderer": "1.2.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "test-renderer": "1.2.0",
    "uuid": "11.1.1"
  }
}
